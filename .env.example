# Copy to .env and adjust.

# Postgres container (docker compose)
POSTGRES_USER=devuser
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=fastapi_db

# App and Alembic
DATABASE_URL=postgresql+psycopg2://devuser:devpassword@localhost:5432/fastapi_db

# JWT signing key, at least 32 random characters
SECRET_KEY=change-me-to-a-long-random-string

# AI (any OpenAI-compatible API, defaults: local Ollama): AI_MODEL judges code answers, AI_CHAT_MODEL runs the quiz dialogue.
# Free hosted alternatives: OpenRouter (https://openrouter.ai/api/v1, a ":free" model)
# or Google Gemini (https://generativelanguage.googleapis.com/v1beta/openai) with their free API keys.
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=qwen2.5-coder:7b
AI_CHAT_MODEL=gemma3:4b
AI_API_KEY=

# Email for password reset links. With SMTP_HOST unset, mail goes to Mailpit from docker compose:
# open http://localhost:8025 to read it. For a real inbox, e.g. Gmail with an app password, set
# SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER, SMTP_PASSWORD and MAIL_FROM.
FRONTEND_URL=http://localhost:5173
